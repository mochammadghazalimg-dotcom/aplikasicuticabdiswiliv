        function handlePengajuanCuti(e) {
            e.preventDefault();
            const nip = document.getElementById('cuti-nip-input').value.trim();
            const jenis = document.getElementById('cuti-jenis').value;
            const mulai = document.getElementById('cuti-mulai').value;
            const durasi = parseInt(document.getElementById('cuti-durasi').value);
            const satuan = document.getElementById('cuti-satuan').value;
            const alasan = document.getElementById('cuti-alasan').value;

            if(!nip || !jenis || !mulai || !durasi || !alasan) { showMessage('Validasi Gagal', 'Mohon lengkapi semua isian form.', 'warning'); return; }

            const asn = dbASN.find(a => a.nip == nip);
            const maxAllowed = ATURAN_CUTI[asn.status].max[jenis];
            const alreadyTaken = asn.cutiDiambil[jenis] || 0;

            if(satuan !== maxAllowed.satuan && !(satuan === 'hari' && maxAllowed.satuan === 'bulan')) {
                if(maxAllowed.satuan === 'hari' && satuan === 'bulan') {
                    showMessage('Pelanggaran Regulasi', `Cuti ${jenis} maksimal adalah ${maxAllowed.val} HARI.`, 'error');
                    return;
                }
            }

            let reqValue = durasi;
            let maxHitung = maxAllowed.val;
            if(maxAllowed.satuan === 'bulan' && satuan === 'hari') maxHitung = maxAllowed.val * 22;

            if (jenis === 'Tahunan') {
                maxHitung += tambahanKuotaLokal;
            }

            if(maxAllowed.satuan === 'bulan' && satuan === 'hari') maxHitung = maxAllowed.val * 22;
            
            if(alreadyTaken + reqValue > maxHitung) {
                 showMessage('Pelanggaran Regulasi BKN', `Pengajuan ditolak. Kuota Cuti ${jenis} tersisa ${maxHitung - alreadyTaken} ${satuan}.`, 'error');
                 return;
            }

            document.getElementById('btn-submit-cuti').innerText = "Menyimpan ke Database...";
            
            const today = new Date().toISOString().split('T')[0];
            const tglAkhir = document.getElementById('cuti-akhir').value;
            const newId = Date.now();

            asn.cutiDiambil[jenis] += durasi;

            google.script.run.withSuccessHandler(function() {
                dbCuti.push({ id: newId, nip: asn.nip, nama: asn.nama, jenis: jenis, tglMulai: mulai, tglAkhir: tglAkhir, durasi: durasi, satuan: satuan, status: 'Disetujui', tglAju: today, alasan: alasan });
                document.getElementById('btn-submit-cuti').innerText = "Ajukan Cuti";
                showMessage('Berhasil Disetujui', `Pengajuan cuti otomatis disetujui.`, 'success');
                navigate('riwayat');
            }).simpanCuti(newId, asn.nip, asn.nama, jenis, mulai, tglAkhir, durasi, satuan, 'Disetujui', today, alasan, JSON.stringify(asn.cutiDiambil));
        }

        function prosesCuti(id, statusTujuan) {
            const cuti = dbCuti.find(c => c.id === id);
            if(cuti) {
                const oldStatus = cuti.status;
                cuti.status = statusTujuan;
                
                const asn = dbASN.find(a => a.nip == cuti.nip);
                if(asn) {
                     if (statusTujuan === 'Disetujui' && oldStatus !== 'Disetujui') asn.cutiDiambil[cuti.jenis] += cuti.durasi;
                     else if (statusTujuan !== 'Disetujui' && oldStatus === 'Disetujui') asn.cutiDiambil[cuti.jenis] -= cuti.durasi;
                }
                
                showMessage('Memproses', 'Merubah status...', 'info');
                google.script.run.withSuccessHandler(function() {
                    loadRiwayat();
                    showMessage('Status Diperbarui', `Cuti ${cuti.nama} telah ${statusTujuan}.`, 'success');
                }).updateStatusCuti(id, statusTujuan, cuti.nip, JSON.stringify(asn ? asn.cutiDiambil : {}));
            }
        }

        function calculateEndDate() {
            const mulai = document.getElementById('cuti-mulai').value;
            const durasi = parseInt(document.getElementById('cuti-durasi').value);
            const satuan = document.getElementById('cuti-satuan').value;
            const outputAkhir = document.getElementById('cuti-akhir');

            if (mulai && durasi && !isNaN(durasi)) {
                let date = new Date(mulai);
                if (satuan === 'hari') date.setDate(date.getDate() + (durasi - 1));
                else if (satuan === 'bulan') { date.setMonth(date.getMonth() + durasi); date.setDate(date.getDate() - 1); }
                outputAkhir.value = date.toISOString().split('T')[0];
            } else outputAkhir.value = '';
        }

