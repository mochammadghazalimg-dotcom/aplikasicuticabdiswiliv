<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIM Cuti - Cabdin Pendidikan Wil IV</title>
    <!-- Tailwind CSS for Modern Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        // Tema Pendidikan: Navy Blue (Wibawa/Profesional) dan Gold/Amber (Prestasi/Pendidikan)
                        edu: {
                            blue: '#1e3a8a',
                            lightBlue: '#3b82f6',
                            gold: '#f59e0b',
                            bg: '#f8fafc'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Glassmorphism utility */
        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="bg-edu-bg font-sans text-gray-800 h-screen flex overflow-hidden">

    <!-- SCREEN LOGIN (TREND 2026) -->
    <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-edu-blue bg-opacity-70 bg-blend-multiply transition-opacity duration-500" style="background-image: url('https://i.imgur.com/yxPiSE9.jpeg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
        <div class="bg-white bg-opacity-95 backdrop-blur-xl p-8 md:p-10 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.4)] w-full max-w-md text-center transform transition-all fade-in border border-white relative overflow-hidden">
            
            <!-- Aksen Dekoratif -->
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-edu-gold via-yellow-400 to-edu-blue"></div>

            <!-- Logo Instansi -->
            <div class="w-24 h-24 mx-auto bg-white rounded-2xl flex items-center justify-center shadow-md mb-6 border border-gray-100 p-2 relative">
                <!-- Gunakan PNG yang lebih stabil dimuat browser, dengan fallback ke Icon FontAwesome -->
                <img src="https://i.imgur.com/N8da60H.png" 
                     alt="Logo Pemprov Sulsel" 
                     class="w-full h-full object-contain drop-shadow-sm z-10 relative" 
                     onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='block';">
                <!-- Fallback Icon jika gambar tetap diblokir internet -->
                <i id="logo-fallback" class="fas fa-university text-5xl text-edu-blue absolute" style="display: none;"></i>
            </div>
            
            <h2 class="text-3xl font-extrabold text-gray-800 mb-2 tracking-tight">SIM CUTI ASN</h2>
            <p class="text-sm font-bold text-edu-blue mb-1 uppercase tracking-wide">Cabang Dinas Pendidikan Wil IV</p>
            <p class="text-xs text-gray-500 mb-8 font-medium">Pemerintah Provinsi Sulawesi Selatan</p>
            
            <form id="form-login" onsubmit="handleLogin(event)" class="space-y-5 relative z-10">
                <div class="relative">
                    <i class="fas fa-user absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="login-user" required placeholder="Username (superadmin / admin)" class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-edu-blue focus:border-transparent transition text-sm font-medium">
                </div>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="password" id="login-pass" required placeholder="Password (123)" class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-edu-blue focus:border-transparent transition text-sm font-medium">
                </div>
                <button type="submit" class="w-full py-3.5 bg-edu-blue text-white font-bold rounded-xl hover:bg-blue-800 transition shadow-lg hover:shadow-xl mt-2 flex items-center justify-center gap-2">
                    Masuk Sistem <i class="fas fa-arrow-right"></i>
                </button>
            </form>
            
            <div class="mt-8 pt-4 border-t border-gray-200 border-opacity-70">
                <p class="text-xs text-gray-500 font-medium">© 2026 Cabang Dinas Pendidikan Wilayah IV</p>
            </div>
        </div>
    </div>

    <!-- MAIN APP WRAPPER (Sembunyi saat di halaman login) -->
    <div id="app-wrapper" class="flex w-full h-full hidden">
        
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-64 bg-edu-blue text-white flex flex-col shadow-xl z-20 hidden md:flex transition-all duration-300 relative">
            <div class="p-6 flex items-center gap-4 border-b border-blue-800">
            <a href="#" onclick="navigate('riwayat')" class="nav-link block px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors" data-target="riwayat">
                <i class="fas fa-history w-6"></i> Riwayat Cuti
            </a>
            <!-- TAMBAHAN: Menu Manajemen Akun (Khusus Super Admin) -->
            <a href="#" id="menu-manajemen-akun" onclick="navigate('manajemen-akun')" class="nav-link hidden px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors" data-target="manajemen-akun">
                <i class="fas fa-user-cog w-6"></i> Manajemen Akun
            </a>
        </nav>
        <div class="p-4 border-t border-blue-800">
            <div class="flex items-center justify-between px-4 py-2">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-blue-700 flex items-center justify-center shadow-inner">
                        <i class="fas fa-shield-alt text-sm text-edu-gold"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold leading-tight" id="active-user-name">Admin Name</p>
                        <p class="text-xs text-blue-300" id="active-user-role">Role</p>
                    </div>
                </div>
                <!-- Tombol Logout -->
                <button onclick="handleLogout()" class="text-blue-300 hover:text-red-400 transition ml-2" title="Keluar dari Sistem">
                    <i class="fas fa-power-off text-lg"></i>
                </button>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <!-- Header Mobile & Global -->
        <header class="bg-white glass shadow-sm z-10 p-4 flex justify-between items-center md:px-8">
            <button class="md:hidden text-edu-blue text-2xl" onclick="toggleMobileMenu()">
                <i class="fas fa-bars"></i>
            </button>
            <h2 class="text-xl font-bold text-gray-800" id="page-title">Dashboard Utama</h2>
            <div class="flex items-center gap-4 text-gray-500">
                <button class="hover:text-edu-blue transition" title="Notifikasi"><i class="fas fa-bell"></i></button>
                <button class="hover:text-edu-blue transition" title="Pengaturan"><i class="fas fa-cog"></i></button>
            </div>
        </header>

        <!-- Dynamic Content Area -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8 relative" id="main-content">
            
            <!-- VIEW: DASHBOARD -->
            <div id="view-dashboard" class="page-view fade-in">
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-blue-100 text-edu-blue flex items-center justify-center text-xl">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Total ASN</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="stat-total">0</h3>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-amber-100 text-edu-gold flex items-center justify-center text-xl">
                            <i class="fas fa-user-clock"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Sedang Cuti</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="stat-cuti">0</h3>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-xl">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Pengajuan Disetujui</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="stat-approved">0</h3>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-red-100 text-red-500 flex items-center justify-center text-xl">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Pengajuan Ditolak</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="stat-rejected">0</h3>
                        </div>
                    </div>
                </div>

                <!-- Info Peraturan -->
                <div class="bg-blue-50 border-l-4 border-edu-blue rounded-r-xl p-5 mb-8">
                    <h4 class="font-bold text-edu-blue mb-2"><i class="fas fa-info-circle mr-2"></i>Sistem Penyesuaian Regulasi Aktif</h4>
                    <p class="text-sm text-gray-700">Aplikasi ini secara otomatis menerapkan <strong>Peraturan BKN No. 7 Tahun 2021</strong> untuk perhitungan cuti PNS dan <strong>Peraturan BKN No. 7 Tahun 2022</strong> untuk PPPK. Cuti di luar ketentuan akan otomatis ditolak oleh sistem formulir.</p>
                </div>

                <!-- Recent Activities -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Pengajuan Cuti Terbaru</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-gray-200 text-sm text-gray-500">
                                    <th class="py-3 px-4 font-semibold">Nama Pegawai</th>
                                    <th class="py-3 px-4 font-semibold">Jenis Cuti</th>
                                    <th class="py-3 px-4 font-semibold">Tgl Mulai</th>
                                    <th class="py-3 px-4 font-semibold">Durasi</th>
                                    <th class="py-3 px-4 font-semibold">Status</th>
                                </tr>
                            </thead>
                            <tbody id="dashboard-recent-table" class="text-sm">
                                <!-- Data inject via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VIEW: DATA ASN -->
            <div id="view-data-asn" class="page-view hidden fade-in">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
                        <h3 class="text-lg font-bold text-gray-800">Daftar Pegawai (PNS & PPPK)</h3>
                        <div class="flex gap-2 flex-wrap justify-end">
                            <div class="relative">
                                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                <input type="text" id="search-asn" onkeyup="loadDataASN()" placeholder="Cari NIP/Nama..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue focus:border-transparent text-sm w-full sm:w-64">
                            </div>
                            <button onclick="downloadTemplate()" class="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition shadow-md text-sm font-medium flex items-center gap-2" title="Download Template Excel">
                                <i class="fas fa-file-excel"></i> Template
                            </button>
                            <button onclick="document.getElementById('upload-template').click()" class="bg-gray-100 text-gray-700 border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-200 transition shadow-md text-sm font-medium flex items-center gap-2" title="Unggah Data dari Template">
                                <i class="fas fa-upload"></i> Unggah
                            </button>
                            <input type="file" id="upload-template" class="hidden" accept=".xlsx, .xls, .csv" onchange="handleUploadTemplate(event)">
                            <button onclick="showModalTambahASN()" class="bg-edu-blue text-white px-4 py-2 rounded-lg hover:bg-blue-800 transition shadow-md text-sm font-medium flex items-center gap-2">
                                <i class="fas fa-plus"></i> Tambah
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-y border-gray-200 text-sm text-gray-600">
                                    <th class="py-3 px-4 font-semibold">NIP / NI PPPK</th>
                                    <th class="py-3 px-4 font-semibold">Nama Lengkap</th>
                                    <th class="py-3 px-4 font-semibold">Status</th>
                                    <th class="py-3 px-4 font-semibold">Jabatan</th>
                                    <th class="py-3 px-4 font-semibold">Sekolah</th>
                                    <th class="py-3 px-4 font-semibold text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="asn-table-body" class="text-sm text-gray-700">
                                <!-- Data inject via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VIEW: PENGAJUAN CUTI -->
            <div id="view-pengajuan" class="page-view hidden fade-in">
                <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                    <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-4">Form Pengajuan Cuti Baru</h3>
                    
                    <form id="form-cuti" onsubmit="handlePengajuanCuti(event)">
                        <!-- Pilih ASN -->
                        <div class="mb-5">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Pilih Pegawai (Ketik NIP / NI PPPK)</label>
                            <div class="flex gap-2">
                                <input type="text" id="cuti-nip-input" placeholder="Masukkan NIP..." required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-white text-gray-700">
                                <button type="button" onclick="cekDataASN()" class="px-5 py-2.5 bg-edu-blue text-white rounded-lg hover:bg-blue-800 transition font-medium whitespace-nowrap shadow-md">
                                    Cek Data
                                </button>
                            </div>
                            <p id="asn-status-info" class="text-xs text-edu-blue mt-1 font-medium hidden">Status: <span id="asn-status-badge"></span></p>
                        </div>

                        <!-- Info Detail ASN (Muncul setelah Cek Data) -->
                        <div id="asn-detail-card" class="mb-5 hidden bg-white p-4 rounded-lg border border-gray-200 shadow-sm fade-in">
                            <p class="text-sm font-bold text-gray-800 mb-2 border-b pb-2">Informasi Pegawai</p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-gray-700">
                                <div><span class="font-semibold text-gray-500">Nama:</span> <span id="detail-nama" class="font-medium"></span></div>
                                <div><span class="font-semibold text-gray-500">NIP:</span> <span id="detail-nip" class="font-medium"></span></div>
                                <div><span class="font-semibold text-gray-500">Status:</span> <span id="detail-status" class="font-medium"></span></div>
                                <div><span class="font-semibold text-gray-500">Jabatan:</span> <span id="detail-jabatan" class="font-medium"></span></div>
                                <div class="md:col-span-2"><span class="font-semibold text-gray-500">Sekolah:</span> <span id="detail-sekolah" class="font-medium"></span></div>
                            </div>
                        </div>

                        <!-- Info Kuota (Muncul setelah pilih ASN) -->
                        <div id="kuota-info-container" class="mb-5 hidden bg-blue-50 p-4 rounded-lg border border-blue-100">
                            <p class="text-sm font-bold text-edu-blue mb-2">Sisa Kuota Cuti (Berdasarkan Aturan BKN)</p>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-xs" id="kuota-grid">
                                <!-- Injected via JS -->
                            </div>
                        </div>

                        <!-- Jenis Cuti -->
                        <div class="mb-5">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Jenis Cuti</label>
                            <select id="cuti-jenis" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-white text-gray-700 disabled:bg-gray-100" disabled>
                                <option value="">-- Pilih ASN Terlebih Dahulu --</option>
                            </select>
                            <p class="text-xs text-gray-500 mt-1 italic" id="cuti-aturan-hint">*Jenis cuti disesuaikan dengan status PNS/PPPK.</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                            <!-- Tanggal Mulai -->
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Tanggal Mulai</label>
                                <input type="date" id="cuti-mulai" required onchange="calculateEndDate()" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700">
                            </div>
                            <!-- Durasi (Hari) -->
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Lama Cuti (Hari Kerja/Bulan)</label>
                                <div class="flex gap-2">
                                    <input type="number" id="cuti-durasi" min="1" required oninput="calculateEndDate()" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700">
                                    <select id="cuti-satuan" onchange="calculateEndDate()" class="w-24 px-2 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-gray-50 text-gray-700">
                                        <option value="hari">Hari</option>
                                        <option value="bulan">Bulan</option>
                                    </select>
                                </div>
                            </div>
                            <!-- Tanggal Akhir (Baru) -->
                            <div class="md:col-span-2">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Tanggal Berakhir</label>
                                <input type="date" id="cuti-akhir" readonly class="w-full px-4 py-2.5 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed">
                                <p class="text-xs text-gray-500 mt-1">*Tanggal berakhir dihitung otomatis dari sistem.</p>
                            </div>
                        </div>

                        <!-- Alasan / Keterangan -->
                        <div class="mb-6">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Alasan Cuti</label>
                            <textarea id="cuti-alasan" rows="3" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700" placeholder="Jelaskan alasan pengajuan..."></textarea>
                        </div>

                        <div class="flex justify-end gap-3">
                            <button type="button" onclick="navigate('dashboard')" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium transition">Batal</button>
                            <button type="submit" class="px-5 py-2.5 rounded-lg bg-edu-blue text-white hover:bg-blue-800 font-medium transition shadow-md">Ajukan Cuti</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- VIEW: RIWAYAT CUTI -->
            <div id="view-riwayat" class="page-view hidden fade-in">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
                        <h3 class="text-lg font-bold text-gray-800">Rekapitulasi & Riwayat Cuti</h3>
                        <div class="relative w-full sm:w-auto">
                            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                            <input type="text" id="search-riwayat" onkeyup="loadRiwayat()" placeholder="Cari NIP/Nama ASN..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-sm w-full sm:w-72">
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-y border-gray-200 text-sm text-gray-600">
                                    <th class="py-3 px-4 font-semibold">Tgl Pengajuan</th>
                                    <th class="py-3 px-4 font-semibold">Pegawai</th>
                                    <th class="py-3 px-4 font-semibold">Jenis Cuti</th>
                                    <th class="py-3 px-4 font-semibold">Durasi</th>
                                    <th class="py-3 px-4 font-semibold">Status</th>
                                    <th class="py-3 px-4 font-semibold text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="riwayat-table-body" class="text-sm text-gray-700">
                                <!-- Data inject via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VIEW: MANAJEMEN AKUN (Khusus Super Admin) -->
            <div id="view-manajemen-akun" class="page-view hidden fade-in">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
                        <h3 class="text-lg font-bold text-gray-800">Manajemen Sistem Akun (Admin & Superadmin)</h3>
                        <div class="flex gap-2 flex-wrap justify-end">
                            <div class="relative">
                                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                <input type="text" id="search-akun" onkeyup="loadManajemenAkun()" placeholder="Cari NIP/Nama/User..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-sm w-full sm:w-64">
                            </div>
                            <button onclick="showModalAkun()" class="bg-edu-blue text-white px-4 py-2 rounded-lg hover:bg-blue-800 transition shadow-md text-sm font-medium flex items-center gap-2">
                                <i class="fas fa-user-plus"></i> Tambah Akun
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
