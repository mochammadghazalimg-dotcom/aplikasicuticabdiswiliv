                        <td class="py-3 px-4"><span class="px-2 py-1 rounded-md text-xs font-semibold ${statusColor}">${c.status}</span></td>
                        <td class="py-3 px-4 text-center">
                            ${aksiHtml}
                        </td>
                    </tr>
                `;
            });
        }

        // 5. ACTION HANDLERS
        function handleTambahASN(e) {
            e.preventDefault();
            const nip = document.getElementById('new-nip').value;
            const nama = document.getElementById('new-nama').value;
            const status = document.getElementById('new-status').value;
            const jabatan = document.getElementById('new-jabatan').value;
            const sekolah = document.getElementById('new-sekolah').value;

            // Simulasi insert DB
            dbASN.push({
                nip, nama, status, jabatan, sekolah,
                cutiDiambil: { 'Tahunan': 0, 'Besar': 0, 'Sakit': 0, 'Melahirkan': 0, 'Alasan Penting': 0, 'CLTN': 0 }
            });

            closeModal('modal-tambah-asn');
            document.getElementById('new-nip').value = '';
            document.getElementById('new-nama').value = '';
            document.getElementById('new-jabatan').value = '';
            document.getElementById('new-sekolah').value = '';

            showMessage('Berhasil', `Data pegawai ${nama} (${status}) berhasil ditambahkan.`, 'success');
            if(!document.getElementById('view-data-asn').classList.contains('hidden')) {
                loadDataASN();
            }
        }

        function handlePengajuanCuti(e) {
            e.preventDefault();
            const nip = document.getElementById('cuti-nip-input').value.trim();
            const jenis = document.getElementById('cuti-jenis').value;
            const mulai = document.getElementById('cuti-mulai').value;
            const durasi = parseInt(document.getElementById('cuti-durasi').value);
            const satuan = document.getElementById('cuti-satuan').value;

            if(!nip || !jenis || !mulai || !durasi) {
                showMessage('Validasi Gagal', 'Mohon lengkapi semua isian form.', 'warning');
                return;
            }

            // VALIDASI BERDASARKAN ATURAN BKN
            const asn = dbASN.find(a => a.nip === nip);
            const maxAllowed = ATURAN_CUTI[asn.status].max[jenis];
            const alreadyTaken = asn.cutiDiambil[jenis] || 0;

            // Validasi Satuan
            if(satuan !== maxAllowed.satuan && !(satuan === 'hari' && maxAllowed.satuan === 'bulan')) {
                // Simplifikasi cek beda satuan
                if(maxAllowed.satuan === 'hari' && satuan === 'bulan') {
                    showMessage('Pelanggaran Regulasi', `Cuti ${jenis} maksimal adalah ${maxAllowed.val} HARI, tidak bisa mengajukan dalam hitungan bulan.`, 'error');
                    return;
                }
            }

            // Validasi Kuota
            let reqValue = durasi;
            // Jika max dalam bulan tapi diisi hari, konversi kasar (1 bulan ~ 22 hari kerja)
            let maxHitung = maxAllowed.val;
            if(maxAllowed.satuan === 'bulan' && satuan === 'hari') {
                maxHitung = maxAllowed.val * 22; // Estimasi hari kerja per bulan
            }

            if(alreadyTaken + reqValue > maxHitung) {
                 showMessage('Pelanggaran Regulasi BKN', `Pengajuan ditolak. Kuota Cuti ${jenis} untuk ${asn.status} tersisa ${maxHitung - alreadyTaken} ${satuan}.`, 'error');
                 return;
            }

            // Lolos Validasi -> Simpan (Otomatis Disetujui)
            const today = new Date().toISOString().split('T')[0];
            const tglAkhir = document.getElementById('cuti-akhir').value;

            dbCuti.push({
                id: Date.now(),
                nip: asn.nip,
                nama: asn.nama,
                jenis: jenis,
                tglMulai: mulai,
                tglAkhir: tglAkhir,
                durasi: durasi,
                satuan: satuan,
                status: 'Disetujui', // Status langsung disetujui
                tglAju: today
            });

            // Langsung potong kuota ASN (Karena otomatis disetujui)
            let pengali = 1;
            asn.cutiDiambil[jenis] += (durasi * pengali);
            
            showMessage('Berhasil Disetujui', `Pengajuan cuti untuk ${asn.nama} otomatis disetujui, dan kuota telah dipotong oleh sistem.`, 'success');
            navigate('riwayat'); // Auto arahkan ke riwayat
        }

        function prosesCuti(id, statusTujuan) {
            const cuti = dbCuti.find(c => c.id === id);
            if(cuti) {
                cuti.status = statusTujuan;
                
                // Jika disetujui, potong kuota ASN (Simulasi Database)
                if(statusTujuan === 'Disetujui') {
                     const asn = dbASN.find(a => a.nip === cuti.nip);
                     if(asn) {
                         let pengali = 1;
                         // Standarisasi potongan ke hari/bulan sesuai aturan 
                         asn.cutiDiambil[cuti.jenis] += (cuti.durasi * pengali);
                     }
                }
                
                loadRiwayat();
                showMessage('Status Diperbarui', `Cuti ${cuti.nama} telah ${statusTujuan}.`, 'success');
            }
        }

        // --- FITUR BARU: Hitung Tanggal Akhir Otomatis ---
        function calculateEndDate() {
            const mulai = document.getElementById('cuti-mulai').value;
            const durasi = parseInt(document.getElementById('cuti-durasi').value);
            const satuan = document.getElementById('cuti-satuan').value;
            const outputAkhir = document.getElementById('cuti-akhir');

            if (mulai && durasi && !isNaN(durasi)) {
                let date = new Date(mulai);
                if (satuan === 'hari') {
                    // Penambahan hari
                    date.setDate(date.getDate() + (durasi - 1)); // -1 karena hari H dihitung
                } else if (satuan === 'bulan') {
                    // Penambahan bulan
                    date.setMonth(date.getMonth() + durasi);
                    date.setDate(date.getDate() - 1);
                }
                outputAkhir.value = date.toISOString().split('T')[0];
            } else {
                outputAkhir.value = '';
            }
        }

        // --- FITUR BARU: Template Excel ASN ---
        function downloadTemplate() {
            showMessage('Mengunduh Template', 'Template Data ASN (template_data_asn.xlsx) sedang diunduh...', 'info');
            // Logic unduh aktual bisa diimplementasi via server nantinya
        }

        function handleUploadTemplate(event) {
            const file = event.target.files[0];
            if (file) {
                showMessage('Unggah Berhasil', `File ${file.name} telah diproses. Data ASN berhasil di-synchronize!`, 'success');
                // Mengosongkan input supaya bisa upload ulang file yang sama jika dibutuhkan
                event.target.value = ''; 
            }
        }

        // --- FITUR LOGIN & MANAJEMEN AKUN ---

        function handleLogin(e) {
            e.preventDefault();
            const user = document.getElementById('login-user').value;
            const pass = document.getElementById('login-pass').value;
            
            const validUser = dbUsers.find(u => u.username === user && u.password === pass);
            
            if(validUser) {
                currentUser = validUser;
                
                // Atur UI Identitas di Sidebar
                document.getElementById('active-user-name').innerText = currentUser.nama;
                document.getElementById('active-user-role').innerText = currentUser.role;
                
                // Tampilkan menu khusus jika role adalah Superadmin
                const menuAkun = document.getElementById('menu-manajemen-akun');
                if(currentUser.role === 'Superadmin') {
                    menuAkun.classList.remove('hidden');
                    menuAkun.classList.add('block');
                } else {
                    menuAkun.classList.add('hidden');
                    menuAkun.classList.remove('block');
                }

                // Efek transisi masuk aplikasi
                document.getElementById('login-screen').classList.add('opacity-0');
                setTimeout(() => {
                    document.getElementById('login-screen').classList.add('hidden');
                    document.getElementById('app-wrapper').classList.remove('hidden');
                    navigate('dashboard');
                    showMessage('Login Berhasil', `Selamat datang, ${currentUser.nama}. Anda login sebagai ${currentUser.role}.`, 'success');
                }, 400);

            } else {
                showMessage('Login Gagal', 'Username atau Password salah. Sistem menolak akses masuk.', 'error');
            }
        }

        function handleLogout() {
            currentUser = null;
            document.getElementById('login-user').value = '';
            document.getElementById('login-pass').value = '';
            
            // Kembalikan ke halaman login
            document.getElementById('app-wrapper').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('login-screen').classList.remove('opacity-0');
            }, 50);
        }

        function loadManajemenAkun() {
            const tbody = document.getElementById('akun-table-body');
            const keyword = document.getElementById('search-akun') ? document.getElementById('search-akun').value.toLowerCase() : '';
            tbody.innerHTML = '';
            
            dbUsers.forEach(u => {
                // Filter pencarian
                if(keyword && !u.nama.toLowerCase().includes(keyword) && !u.nip.includes(keyword) && !u.username.toLowerCase().includes(keyword)) return;
                
                const roleBadge = u.role === 'Superadmin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700';
                
                tbody.innerHTML += `
                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                        <td class="py-3 px-4 font-mono text-xs">${u.nip}</td>
                        <td class="py-3 px-4 font-medium">${u.nama}</td>
                        <td class="py-3 px-4">${u.username}</td>
                        <td class="py-3 px-4 text-xs font-mono bg-gray-50 border border-gray-200 rounded px-2">${u.password}</td>
                        <td class="py-3 px-4"><span class="px-2 py-1 rounded-md text-xs font-bold shadow-sm ${roleBadge}">${u.role}</span></td>
                        <td class="py-3 px-4 text-center">
                            <button onclick="editAkun(${u.id})" class="bg-amber-100 text-amber-600 hover:bg-amber-200 px-3 py-1.5 rounded-lg transition text-xs font-semibold shadow-sm" title="Edit Akun & Reset Password">
                                <i class="fas fa-pen mr-1"></i> Edit
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        function showModalAkun() {
            document.getElementById('modal-akun-title').innerText = 'Tambah Akun Admin Baru';
            document.getElementById('akun-id').value = '';
            document.getElementById('akun-nip').value = '';
            document.getElementById('akun-nama').value = '';
            document.getElementById('akun-user').value = '';
            document.getElementById('akun-pass').value = '';
            document.getElementById('akun-role').value = 'Admin';

            document.getElementById('modal-akun').classList.remove('hidden');
            document.getElementById('modal-overlay').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('modal-akun-content').classList.remove('scale-95', 'opacity-0');
                document.getElementById('modal-akun-content').classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function editAkun(id) {
            const akun = dbUsers.find(u => u.id === id);
            if(akun) {
                document.getElementById('modal-akun-title').innerText = 'Edit Akun / Reset Password';
                document.getElementById('akun-id').value = akun.id;
                document.getElementById('akun-nip').value = akun.nip;
                document.getElementById('akun-nama').value = akun.nama;
                document.getElementById('akun-user').value = akun.username;
                document.getElementById('akun-pass').value = akun.password;
                document.getElementById('akun-role').value = akun.role;

                document.getElementById('modal-akun').classList.remove('hidden');
                document.getElementById('modal-overlay').classList.remove('hidden');
                setTimeout(() => {
                    document.getElementById('modal-akun-content').classList.remove('scale-95', 'opacity-0');
                    document.getElementById('modal-akun-content').classList.add('scale-100', 'opacity-100');
                }, 10);
            }
        }

        function handleSimpanAkun(e) {
            e.preventDefault();
            const id = document.getElementById('akun-id').value;
            const nip = document.getElementById('akun-nip').value;
            const nama = document.getElementById('akun-nama').value;
            const user = document.getElementById('akun-user').value;
            const pass = document.getElementById('akun-pass').value;
            const role = document.getElementById('akun-role').value;

            if (id) {
                // Proses Edit (Termasuk Reset Password)
                const akun = dbUsers.find(u => u.id == id);
                akun.nip = nip;
                akun.nama = nama;
                akun.username = user;
                akun.password = pass; // Mereset password dengan form ini
                akun.role = role;
                showMessage('Data Akun Diperbarui', `Akun ${nama} berhasil disimpan/reset password.`, 'success');
            } else {
                // Proses Tambah Akun Baru
                dbUsers.push({
                    id: Date.now(), nip, nama, username: user, password: pass, role
                });
                showMessage('Akun Ditambahkan', `Akun baru atas nama ${nama} berhasil ditambahkan ke sistem.`, 'success');
            }
            
            closeModal('modal-akun');
            loadManajemenAkun();
        }

        // Initialize App
        window.onload = () => {
            // Hilangkan perintah load dashboard otomatis karena sekarang diawali Login Screen
            // navigate('dashboard'); 
        };

    </script>
