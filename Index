    <!-- Javascript Logic -->
    <script>
        let dbRekapan = [];
        let tambahanKuotaLokal = 0; // Untuk menyimpan sementara akumulasi tambahan
        let dbUsers = [];
        let dbASN = [];
        let dbCuti = [];
        let listSekolah = [];
        let currentUser = null; 

        const ATURAN_CUTI = {
            PNS: {
                jenis: ['Tahunan', 'Besar', 'Sakit', 'Melahirkan', 'Alasan Penting', 'CLTN'],
                max: { 'Tahunan': {val: 12, satuan: 'hari'}, 'Besar': {val: 3, satuan: 'bulan'}, 'Sakit': {val: 365, satuan: 'hari'}, 'Melahirkan': {val: 3, satuan: 'bulan'}, 'Alasan Penting': {val: 1, satuan: 'bulan'}, 'CLTN': {val: 3, satuan: 'tahun'} }
            },
            PPPK: {
                jenis: ['Tahunan', 'Sakit', 'Melahirkan'],
                max: { 'Tahunan': {val: 12, satuan: 'hari'}, 'Sakit': {val: 30, satuan: 'hari'}, 'Melahirkan': {val: 3, satuan: 'bulan'} }
            }
        };

        window.onload = () => {
            document.getElementById('btn-login').innerHTML = 'Menghubungkan Server... <i class="fas fa-spinner fa-spin"></i>';
            document.getElementById('btn-login').disabled = true;
            
            google.script.run
            .withFailureHandler(function(error) {
                document.getElementById('btn-login').innerHTML = 'Gagal Terhubung!';
                alert('Pesan Error: ' + error.message);
            })
            .withSuccessHandler(function(data) {
                if(data.dbUsers.length > 0) {
                     dbUsers = data.dbUsers;
                } else {
                     dbUsers = [{ id: 1, nip: '-', nama: 'Sistem Admin', username: 'superadmin', password: '123', role: 'Superadmin' }];
                }
                dbASN = data.dbASN;
                dbCuti = data.dbCuti;
                dbRekapan = data.dbRekapan || [];
                // Cek apakah butuh memunculkan popup awal tahun
                if (data.showPopupAwalTahun) {
                    showMessage("Informasi Sistem", "System sudah melakukan update data pada data base Rekapan silahkan melapor ke Ghazali untuk pengecekan", "info");
                }

                initFilterSekolah(); // Siapkan list sekolah sebelum masuk
                
                document.getElementById('btn-login').innerHTML = 'Masuk Sistem <i class="fas fa-arrow-right"></i>';
                document.getElementById('btn-login').disabled = false;
            }).getDB();
        };

        // Mengisi pilihan nama sekolah di filter Data ASN
        function initFilterSekolah() {
            const select = document.getElementById('filter-sekolah');
            listSekolah = [...new Set(dbASN.map(a => a.sekolah))].filter(s => s && s.trim() !== '-').sort();
            
            select.innerHTML = '<option value="">-- Tampilkan Semua Sekolah --</option>';
            listSekolah.forEach(s => {
                select.innerHTML += `<option value="${s}">${s}</option>`;
            });

            // Set default agar hanya SMAN 1 WAJO yang tampil pertama kali agar tidak hang
            if (listSekolah.includes('SMAN 1 WAJO')) {
                select.value = 'SMAN 1 WAJO';
            } else if (listSekolah.length > 0) {
                select.value = listSekolah[0]; // Set ke sekolah pertama jika SMAN 1 tidak ada
            }
        }

        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('hidden');
        }

        function navigate(pageId) {
            document.querySelectorAll('.page-view').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-link').forEach(el => {
                el.classList.remove('bg-blue-800', 'text-edu-gold');
                el.classList.add('text-white');
            });
            document.getElementById(`view-${pageId}`).classList.remove('hidden');
            
            const activeNav = document.querySelector(`.nav-link[data-target="${pageId}"]`);
            if(activeNav) {
                activeNav.classList.add('bg-blue-800', 'text-edu-gold');
                activeNav.classList.remove('text-white');
            }
            
            const sidebar = document.getElementById('sidebar');
            if (sidebar) sidebar.classList.add('hidden');
            
            const titles = { 'dashboard': 'Dashboard Utama', 'data-asn': 'Manajemen Data ASN', 'pengajuan': 'Form Pengajuan Cuti', 'riwayat': 'Riwayat Pengajuan Cuti', 'manajemen-akun': 'Manajemen Sistem Akun Admin' };
            document.getElementById('page-title').innerText = titles[pageId];

            if(pageId === 'dashboard') loadDashboard();
            if(pageId === 'data-asn') loadDataASN();
            if(pageId === 'pengajuan') loadFormPengajuan();
            if(pageId === 'riwayat') loadRiwayat();
            if(pageId === 'manajemen-akun') loadManajemenAkun();
        }

        function showMessage(title, desc, type = 'info') {
            const modal = document.getElementById('modal-message');
            const overlay = document.getElementById('modal-overlay');
            const content = document.getElementById('modal-message-content');
            const iconContainer = document.getElementById('msg-icon');
            const btn = document.getElementById('msg-btn');
            document.getElementById('msg-title').innerText = title;
            document.getElementById('msg-desc').innerText = desc;
            iconContainer.className = 'w-16 h-16 rounded-full mx-auto flex items-center justify-center text-3xl mb-4';
            btn.className = 'w-full px-4 py-2 rounded-xl text-white font-medium transition shadow-md';
            if(type === 'success') {
                iconContainer.classList.add('bg-green-100', 'text-green-500');
                iconContainer.innerHTML = '<i class="fas fa-check"></i>';
                btn.classList.add('bg-green-500', 'hover:bg-green-600');
            } else if (type === 'error' || type === 'warning') {
                iconContainer.classList.add('bg-red-100', 'text-red-500');
                iconContainer.innerHTML = '<i class="fas fa-exclamation"></i>';
                btn.classList.add('bg-red-500', 'hover:bg-red-600');
            } else {
                iconContainer.classList.add('bg-blue-100', 'text-edu-blue');
                iconContainer.innerHTML = '<i class="fas fa-info"></i>';
                btn.classList.add('bg-edu-blue', 'hover:bg-blue-800');
            }
            modal.classList.remove('hidden');
            overlay.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal(modalId) {
            const contentId = modalId + '-content';
            const content = document.getElementById(contentId);
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                document.getElementById(modalId).classList.add('hidden');
                document.getElementById('modal-overlay').classList.add('hidden');
            }, 200);
        }

        function showModalTambahASN() {
            document.getElementById('modal-tambah-asn').classList.remove('hidden');
            document.getElementById('modal-overlay').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('modal-tambah-asn-content').classList.remove('scale-95', 'opacity-0');
                document.getElementById('modal-tambah-asn-content').classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        // --- PEMBARUAN FUNGSI DASHBOARD (TEMA MODERN) ---
        function loadDashboard() {
            // Update Stat Atas
            document.getElementById('stat-total').innerText = dbASN.length;
            document.getElementById('stat-sekolah').innerText = listSekolah.length;
            document.getElementById('stat-cuti').innerText = dbCuti.length;
            document.getElementById('stat-approved').innerText = dbCuti.filter(c => c.status === 'Disetujui').length;

            // Agregasi Data Cuti
            const rekap = {};
            const jenisAll = ['Tahunan', 'Sakit', 'Melahirkan', 'Besar', 'Alasan Penting', 'CLTN'];
            jenisAll.forEach(j => rekap[j] = { totalUsulan: 0, setASN: new Set() });

            let maxUsulan = 1;
            let maxAsn = 1;

            dbCuti.forEach(c => {
                let j = c.jenis;
                if(j.startsWith('Cuti ')) j = j.replace('Cuti ', '');
                if(rekap[j]) {
                    rekap[j].totalUsulan++;
                    rekap[j].setASN.add(c.nip);
                }
            });

            // Cari nilai Max untuk progress bar HTML
            jenisAll.forEach(j => {
                if (rekap[j].totalUsulan > maxUsulan) maxUsulan = rekap[j].totalUsulan;
                if (rekap[j].setASN.size > maxAsn) maxAsn = rekap[j].setASN.size;
            });

            const divUsulan = document.getElementById('chart-usulan');
            const divAsn = document.getElementById('chart-asn');
            divUsulan.innerHTML = '';
            divAsn.innerHTML = '';

            // Warna-warni Chart
            const colors = {
                'Tahunan': 'bg-blue-500', 'Sakit': 'bg-red-400', 'Melahirkan': 'bg-pink-400', 
                'Besar': 'bg-purple-500', 'Alasan Penting': 'bg-amber-400', 'CLTN': 'bg-gray-600'
            };

            jenisAll.forEach(j => {
                const total = rekap[j].totalUsulan;
                const asns = rekap[j].setASN.size;
                
                const wUsulan = (total / maxUsulan) * 100;
                const wAsn = (asns / maxAsn) * 100;
                const bg = colors[j] || 'bg-edu-blue';

                // Chart Usulan
                divUsulan.innerHTML += `
                    <div>
                        <div class="flex justify-between text-sm font-semibold mb-1">
                            <span class="text-gray-700">Cuti ${j}</span>
                            <span class="text-gray-900">${total} Berkas</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-3">
                            <div class="${bg} h-3 rounded-full stat-bar" style="width: 0%" data-target="${wUsulan}%"></div>
                        </div>
                    </div>
                `;

                // Chart ASN
                divAsn.innerHTML += `
                    <div>
                        <div class="flex justify-between text-sm font-semibold mb-1">
                            <span class="text-gray-700">Cuti ${j}</span>
                            <span class="text-gray-900">${asns} Orang</span>
