        function handleUploadTemplate(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, {type: 'array'});
                    const firstSheetName = workbook.SheetNames[0];
                    const jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheetName]);
                    
                    if(jsonData.length > 0) {
                        const hasDuplicate = jsonData.some(row => {
                            const nipRow = row['NIP'] || row['NIP / NI PPPK'] || row['nip'] || '-';
                            return dbASN.some(a => a.nip == nipRow);
                        });

                        if (hasDuplicate) {
                            showMessage('Peringatan', 'DATA ASN SUDAH TERSEDIA CEK DATA PEGAWAI TERLEBIH DAHULU SEBELUM MENAMBAH', 'warning');
                            event.target.value = ''; 
                            return;
                        }

                        showMessage('Memproses Data...', 'Menyimpan data ke Spreadsheet.', 'info');
                        google.script.run.withSuccessHandler(function() {
                            showMessage('Unggah Berhasil', `Data berhasil disimpan!`, 'success');
                            event.target.value = ''; 
                            google.script.run.withSuccessHandler(function(newData) {
                                dbASN = newData.dbASN;
                                initFilterSekolah(); // Perbarui list sekolah setelah unggah
                                loadDataASN();
                            }).getDB();
                        }).uploadASNBulk(jsonData);
                    } else {
                        showMessage('Gagal', 'File Kosong / Format Salah.', 'error');
                    }
                };
                reader.readAsArrayBuffer(file);
            }
        }

