                    showMessage("Pengajuan Ditolak", `ASN ini sudah pengusulan Cuti Tahunan pada: \n${rekapan.tahun1}`, "error");
                    return;
                }
                tambahanKuotaLokal = 6;
                showMessage("Akumulasi Diterima", "Berhasil menambah 6 Hari pada Kuota Cuti Tahunan.", "success");
            } else if (tipe === 2) {
                if (rekapan && rekapan.tahun1 && rekapan.tahun2) {
                    showMessage("Pengajuan Ditolak", `ASN ini sudah pengusulan Cuti Tahunan pada: \nTahun 1: ${rekapan.tahun1}\nTahun 2: ${rekapan.tahun2}`, "error");
                    return;
                }
                tambahanKuotaLokal = 12;
                showMessage("Akumulasi Diterima", "Berhasil menambah 12 Hari pada Kuota Cuti Tahunan.", "success");
            }
            
            updateFormRules(nip);
        }

