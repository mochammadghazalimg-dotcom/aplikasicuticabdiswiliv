<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-TARA CUTI WIL IV</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- XLSX Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        edu: { blue: '#1e3a8a', lightBlue: '#3b82f6', gold: '#f59e0b', bg: '#f4f7fb' }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .glass { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.4); }
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .stat-bar { transition: width 1s ease-in-out; }
        @media print {
            body * { visibility: hidden; }
            #area-cetak-pdf, #area-cetak-pdf * { visibility: visible; }
            #area-cetak-pdf { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; box-shadow: none; border: none; }
            .print\:hidden { display: none !important; }
            .print\:block { display: block !important; }
        }
    </style>
</head>
<body class="bg-edu-bg font-sans text-gray-800 h-screen flex overflow-hidden">

    <!-- SCREEN LOGIN -->
    <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-edu-blue bg-opacity-70 bg-blend-multiply transition-opacity duration-500" style="background-image: url('https://i.imgur.com/yxPiSE9.jpeg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
        <div class="bg-white bg-opacity-95 backdrop-blur-xl p-8 md:p-10 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.4)] w-full max-w-md text-center transform transition-all fade-in border border-white relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-edu-gold via-yellow-400 to-edu-blue"></div>
            <div class="w-24 h-24 mx-auto bg-white rounded-2xl flex items-center justify-center shadow-md mb-6 border border-gray-100 p-2 relative">
                <img src="https://i.imgur.com/N8da60H.png" alt="Logo Pemprov Sulsel" class="w-full h-full object-contain drop-shadow-sm z-10 relative" onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='block';">
                <i id="logo-fallback" class="fas fa-university text-5xl text-edu-blue absolute" style="display: none;"></i>
            </div>
            
            <h2 class="text-3xl font-extrabold text-gray-800 mb-2 tracking-tight">E-TARA CUTI ASN</h2>
            <p class="text-sm font-bold text-edu-blue mb-1 uppercase tracking-wide">Cabang Dinas Pendidikan Wil. IV</p>
            <p class="text-xs text-gray-500 mb-8 font-medium">Pemerintah Provinsi Sulawesi Selatan</p>
            
            <form id="form-login" onsubmit="handleLogin(event)" class="space-y-5 relative z-10">
                <div class="relative">
                    <i class="fas fa-user absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="login-user" required placeholder="Username" class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-edu-blue focus:border-transparent transition text-sm font-medium">
                </div>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="password" id="login-pass" required placeholder="Password" class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-edu-blue focus:border-transparent transition text-sm font-medium">
                </div>
                <button type="submit" id="btn-login" class="w-full py-3.5 bg-edu-blue text-white font-bold rounded-xl hover:bg-blue-800 transition shadow-lg hover:shadow-xl mt-2 flex items-center justify-center gap-2">
                    Masuk Sistem <i class="fas fa-arrow-right"></i>
                </button>
            </form>
            <div class="mt-8 pt-4 border-t border-gray-200 border-opacity-70">
                <p class="text-xs text-gray-500 font-medium">© 2026 Cabang Dinas Pendidikan Wilayah IV</p>
            </div>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="app-wrapper" class="flex w-full h-full hidden">
        <aside id="sidebar" class="w-64 bg-edu-blue text-white flex flex-col shadow-xl z-20 hidden md:flex transition-all duration-300 relative">
            <div class="p-5 flex flex-col gap-3 border-b border-blue-800">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-inner p-1 shrink-0">
                          <img src="https://i.imgur.com/N8da60H.png" alt="Logo" class="w-full h-full object-contain">
                    </div>
                    <div>
                        <h1 class="text-base font-bold leading-tight tracking-wide text-white">E-TARA CUTI</h1>
                        <p class="text-[11px] text-blue-200 font-medium">Elektronik Tertib Administrasi Cuti</p>
                    </div>
                </div>
                <div class="text-center pt-1 border-t border-blue-800/50">
                    <p class="text-[11px] text-blue-200 font-semibold uppercase tracking-wider">Cabdin Pendidikan Wil IV</p>
                </div>
            </div>
            
            <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto" id="sidebar-menu">
                <a href="#" onclick="navigate('dashboard')" class="nav-link block px-4 py-3 rounded-xl bg-blue-800 text-edu-gold transition-colors font-medium shadow-sm" data-target="dashboard">
                    <i class="fas fa-th-large w-6 text-center"></i> Dashboard Utama
                </a>
                <a href="#" onclick="navigate('data-asn')" class="nav-link block px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors text-white font-medium" data-target="data-asn">
                    <i class="fas fa-users w-6 text-center"></i> Data ASN
                </a>
                <a href="#" onclick="navigate('pengajuan')" class="nav-link block px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors text-white font-medium" data-target="pengajuan">
                    <i class="fas fa-file-signature w-6 text-center"></i> Form Pengajuan
                </a>
                <a href="#" onclick="navigate('riwayat')" class="nav-link block px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors text-white font-medium" data-target="riwayat">
                    <i class="fas fa-history w-6 text-center"></i> Riwayat Cuti
                </a>
                <a href="#" id="menu-manajemen-akun" onclick="navigate('manajemen-akun')" class="nav-link hidden px-4 py-3 rounded-xl hover:bg-blue-800 hover:text-edu-gold transition-colors text-white font-medium" data-target="manajemen-akun">
                    <i class="fas fa-user-shield w-6 text-center"></i> Manajemen Akun
                </a>
            </nav>
            
            <div class="p-4 border-t border-blue-800">
                <div class="flex items-center justify-between px-4 py-2">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-blue-700 flex items-center justify-center shadow-inner">
                            <i class="fas fa-shield-alt text-sm text-edu-gold"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold leading-tight text-white" id="active-user-name">Admin Name</p>
                            <p class="text-[10px] font-bold text-edu-gold uppercase tracking-wider" id="active-user-role">Role</p>
                        </div>
                    </div>
                    <button onclick="handleLogout()" class="text-blue-300 hover:text-red-400 transition ml-2" title="Keluar">
                        <i class="fas fa-power-off text-lg"></i>
                    </button>
                </div>
            </div>
        </aside>

        <main class="flex-1 flex flex-col h-screen overflow-hidden">
            <header class="bg-white glass shadow-sm z-10 p-4 flex justify-between items-center md:px-8">
                <button class="md:hidden text-edu-blue text-2xl" onclick="toggleMobileMenu()">
                    <i class="fas fa-bars"></i>
                </button>
                <h2 class="text-xl font-bold text-gray-800" id="page-title">Dashboard Utama</h2>
                <div class="flex items-center gap-4 text-gray-500">
                    <div class="text-xs font-semibold text-edu-blue bg-blue-50 px-3 py-1.5 rounded-full border border-blue-100 hidden sm:block">
                        <i class="fas fa-calendar-alt mr-1"></i> Tahun Anggaran 2026
                    </div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto p-4 md:p-8 relative" id="main-content">
                <!-- DASHBOARD TEMA MODERN 2026 -->
                <div id="view-dashboard" class="page-view fade-in">
                    <!-- Top Statistic Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                        <div class="rounded-2xl p-6 shadow-lg bg-gradient-to-br from-blue-900 to-edu-blue text-white transform hover:scale-105 transition duration-300 border border-blue-700 relative overflow-hidden">
                            <i class="fas fa-users absolute -right-4 -bottom-4 text-7xl opacity-20"></i>
                            <p class="text-sm font-semibold text-blue-100 uppercase tracking-wider">Total Pegawai ASN</p>
                            <h3 class="text-4xl font-extrabold mt-2" id="stat-total">0</h3>
                            <p class="text-xs text-blue-200 mt-2"><i class="fas fa-info-circle"></i> Terdaftar di Database</p>
                        </div>
                        <div class="rounded-2xl p-6 shadow-lg bg-gradient-to-br from-emerald-600 to-teal-400 text-white transform hover:scale-105 transition duration-300 border border-emerald-500 relative overflow-hidden">
                            <i class="fas fa-school absolute -right-4 -bottom-4 text-7xl opacity-20"></i>
                            <p class="text-sm font-semibold text-emerald-100 uppercase tracking-wider">Total Sekolah/Instansi</p>
                            <h3 class="text-4xl font-extrabold mt-2" id="stat-sekolah">0</h3>
                            <p class="text-xs text-emerald-100 mt-2"><i class="fas fa-map-marker-alt"></i> Area Cabdin Wil. IV</p>
                        </div>
                        <div class="rounded-2xl p-6 shadow-lg bg-gradient-to-br from-amber-500 to-orange-400 text-white transform hover:scale-105 transition duration-300 border border-amber-400 relative overflow-hidden">
                            <i class="fas fa-file-signature absolute -right-4 -bottom-4 text-7xl opacity-20"></i>
                            <p class="text-sm font-semibold text-amber-100 uppercase tracking-wider">Total Pengajuan Cuti</p>
                            <h3 class="text-4xl font-extrabold mt-2" id="stat-cuti">0</h3>
                            <p class="text-xs text-amber-100 mt-2"><i class="fas fa-clock"></i> Riwayat Keseluruhan</p>
                        </div>
                        <div class="rounded-2xl p-6 shadow-lg bg-gradient-to-br from-purple-700 to-fuchsia-500 text-white transform hover:scale-105 transition duration-300 border border-purple-500 relative overflow-hidden">
                            <i class="fas fa-check-circle absolute -right-4 -bottom-4 text-7xl opacity-20"></i>
                            <p class="text-sm font-semibold text-purple-100 uppercase tracking-wider">Pengajuan Disetujui</p>
                            <h3 class="text-4xl font-extrabold mt-2" id="stat-approved">0</h3>
                            <p class="text-xs text-purple-200 mt-2"><i class="fas fa-chart-line"></i> Status Diterima</p>
                        </div>
                    </div>

                    <!-- Main Dashboard Content (Charts) -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Panel 1: Jumlah Pengusulan Cuti -->
                        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                            <h3 class="text-lg font-extrabold text-gray-800 mb-6 flex items-center gap-2">
                                <span class="bg-edu-blue text-white w-8 h-8 rounded-lg flex items-center justify-center"><i class="fas fa-chart-bar"></i></span>
                                Jumlah Pengusulan (Berkas) per Jenis Cuti
                            </h3>
                            <div id="chart-usulan" class="space-y-5">
                                <!-- Data injected via JS -->
                            </div>
                        </div>

                        <!-- Panel 2: Jumlah ASN Pengusul -->
                        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                            <h3 class="text-lg font-extrabold text-gray-800 mb-6 flex items-center gap-2">
                                <span class="bg-edu-gold text-white w-8 h-8 rounded-lg flex items-center justify-center"><i class="fas fa-user-tag"></i></span>
                                Jumlah ASN (Orang) yang Mengajukan Cuti
                            </h3>
                            <div id="chart-asn" class="space-y-5">
                                <!-- Data injected via JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DATA ASN -->
                <div id="view-data-asn" class="page-view hidden fade-in">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <div class="flex flex-col xl:flex-row justify-between items-center mb-6 gap-4">
                            <h3 class="text-lg font-bold text-gray-800 min-w-max">Database Pegawai ASN</h3>
                            
                            <div class="flex gap-2 flex-wrap justify-end w-full">
                                <!-- FITUR FILTER SEKOLAH -->
                                <div class="relative min-w-[200px] flex-grow sm:flex-grow-0">
                                    <i class="fas fa-school absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                    <select id="filter-sekolah" onchange="loadDataASN()" class="pl-10 pr-8 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-sm w-full bg-gray-50 font-semibold text-edu-blue appearance-none cursor-pointer hover:bg-gray-100 transition">
                                        <option value="">-- Memuat Data Sekolah --</option>
                                    </select>
                                    <i class="fas fa-chevron-down absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
                                </div>
                                
                                <div class="relative w-full sm:w-auto">
                                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                    <input type="text" id="search-asn" onkeyup="loadDataASN()" placeholder="Cari NIP/Nama..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-sm w-full sm:w-48">
                                </div>
                                <button onclick="downloadTemplate()" class="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition shadow-md text-sm font-medium flex items-center gap-2">
                                    <i class="fas fa-file-excel"></i> Template
                                </button>
                                <button onclick="document.getElementById('upload-template').click()" class="bg-gray-100 text-gray-700 border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-200 transition shadow-md text-sm font-medium flex items-center gap-2">
                                    <i class="fas fa-upload"></i> Unggah
                                </button>
                                <input type="file" id="upload-template" class="hidden" accept=".xlsx, .xls, .csv" onchange="handleUploadTemplate(event)">
                                <button onclick="showModalTambahASN()" class="bg-edu-blue text-white px-4 py-2 rounded-lg hover:bg-blue-800 transition shadow-md text-sm font-medium flex items-center gap-2">
                                    <i class="fas fa-plus"></i> Tambah
                                </button>
                            </div>
                        </div>
                        <div class="overflow-x-auto rounded-lg border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-100 border-b border-gray-200 text-sm text-gray-700">
                                        <th class="py-3 px-4 font-bold">NIP / NI PPPK</th>
                                        <th class="py-3 px-4 font-bold">Nama Lengkap</th>
                                        <th class="py-3 px-4 font-bold">Status</th>
                                        <th class="py-3 px-4 font-bold">Jabatan</th>
                                        <th class="py-3 px-4 font-bold">Sekolah</th>
                                        <th class="py-3 px-4 font-bold text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="asn-table-body" class="text-sm text-gray-700"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- PENGAJUAN CUTI -->
                <div id="view-pengajuan" class="page-view hidden fade-in">
                    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                        <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-4">Form Pengajuan Cuti Baru</h3>
                        
                        <form id="form-cuti" onsubmit="handlePengajuanCuti(event)">
                            <div class="mb-5">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Pilih Pegawai (Ketik NIP / NI PPPK)</label>
                                <div class="flex gap-2">
                                    <input type="text" id="cuti-nip-input" placeholder="Masukkan NIP..." required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-white text-gray-700">
                                    <button type="button" onclick="cekDataASN()" class="px-5 py-2.5 bg-edu-blue text-white rounded-lg hover:bg-blue-800 transition font-medium whitespace-nowrap shadow-md">
                                        Cek Data
                                    </button>
                                </div>
                                <p id="asn-status-info" class="text-xs text-edu-blue mt-1 font-medium hidden">Status: <span id="asn-status-badge"></span></p>
                            </div>

                            <div id="asn-detail-card" class="mb-5 hidden bg-white p-4 rounded-lg border border-gray-200 shadow-sm fade-in">
                                <p class="text-sm font-bold text-gray-800 mb-2 border-b pb-2">Informasi Pegawai</p>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-gray-700">
                                    <div><span class="font-semibold text-gray-500">Nama:</span> <span id="detail-nama" class="font-medium"></span></div>
                                    <div><span class="font-semibold text-gray-500">NIP:</span> <span id="detail-nip" class="font-medium"></span></div>
                                    <div><span class="font-semibold text-gray-500">Status:</span> <span id="detail-status" class="font-medium"></span></div>
                                    <div><span class="font-semibold text-gray-500">Jabatan:</span> <span id="detail-jabatan" class="font-medium"></span></div>
                                    <div class="md:col-span-2"><span class="font-semibold text-gray-500">Sekolah:</span> <span id="detail-sekolah" class="font-medium"></span></div>
                                </div>
                            </div>

                            <div id="kuota-info-container" class="mb-5 hidden bg-blue-50 p-4 rounded-lg border border-blue-100">
                                <p class="text-sm font-bold text-edu-blue mb-2">Sisa Kuota Cuti (Berdasarkan Aturan BKN)</p>
                                <div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-xs" id="kuota-grid"></div>
                            </div>

                            <div class="mb-5">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Jenis Cuti</label>
                                <select id="cuti-jenis" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-white text-gray-700 disabled:bg-gray-100" disabled>
                                    <option value="">-- Pilih ASN Terlebih Dahulu --</option>
                                </select>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tanggal Mulai</label>
                                    <input type="date" id="cuti-mulai" required onchange="calculateEndDate()" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Lama Cuti (Hari Kerja/Bulan)</label>
                                    <div class="flex gap-2">
                                        <input type="number" id="cuti-durasi" min="1" required oninput="calculateEndDate()" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700">
                                        <select id="cuti-satuan" onchange="calculateEndDate()" class="w-24 px-2 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue bg-gray-50 text-gray-700">
                                            <option value="hari">Hari</option>
                                            <option value="bulan">Bulan</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tanggal Berakhir</label>
                                    <input type="date" id="cuti-akhir" readonly class="w-full px-4 py-2.5 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed">
                                </div>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Alasan Cuti</label>
                                <textarea id="cuti-alasan" rows="3" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-gray-700" placeholder="Jelaskan alasan pengajuan..."></textarea>
                            </div>

                            <div class="flex justify-end gap-3">
                                <button type="button" onclick="navigate('dashboard')" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium transition">Batal</button>
                                <button type="submit" id="btn-submit-cuti" class="px-5 py-2.5 rounded-lg bg-edu-blue text-white hover:bg-blue-800 font-medium transition shadow-md">Ajukan Cuti</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- RIWAYAT CUTI -->
                <div id="view-riwayat" class="page-view hidden fade-in">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
                            <h3 class="text-lg font-bold text-gray-800">Rekapitulasi & Riwayat Cuti</h3>
                            <div class="flex gap-2 flex-wrap justify-end w-full sm:w-auto">
                                <div class="relative w-full sm:w-auto">
                                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                    <input type="text" id="search-riwayat" onkeyup="loadRiwayat()" placeholder="Cari NIP/Nama ASN..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-edu-blue text-sm w-full sm:w-72">
                                </div>
                                <button onclick="downloadExcelRiwayat()" id="btn-export-excel" class="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition shadow-md text-sm font-medium flex items-center gap-2">
