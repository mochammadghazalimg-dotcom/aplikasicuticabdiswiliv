function getDaftarHariLibur(ss) {
  var targetSS = ss || SpreadsheetApp.openById(SHEET_ID);
  var sheet = initSheetHariLibur(targetSS);
  var data = sheet.getDataRange().getValues().slice(1);
  var tz = Session.getScriptTimeZone();
  var hasil = [];

  for (var i = 0; i < data.length; i++) {
    var raw = data[i][0];
    if (!raw) continue;
    var tglStr = "";
    if (raw instanceof Date) {
      tglStr = Utilities.formatDate(raw, tz, "yyyy-MM-dd");
    } else {
      var s = String(raw).trim();
      if (/^\d{4}-\d{2}-\d{2}$/.test(s)) {
        tglStr = s;
      } else if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)) {
        var p = s.split("/");
        tglStr = p[2] + "-" + ("0" + p[1]).slice(-2) + "-" + ("0" + p[0]).slice(-2);
      }
    }
    if (tglStr) hasil.push(tglStr);
  }
  return hasil;
}

function generateTanggalHariKerjaCuti(tglMulai, tglAkhir, durasi, satuan) {
  var daftarLibur = getDaftarHariLibur();
  var mapLibur = {};
  daftarLibur.forEach(function(t) { mapLibur[t] = true; });

  var pMulai = String(tglMulai).split('-');
  var cur = new Date(Date.UTC(parseInt(pMulai[0], 10), parseInt(pMulai[1], 10) - 1, parseInt(pMulai[2], 10)));
  var hasilTanggal = [];

  if (String(satuan).toLowerCase() === 'hari') {
    var targetHari = parseInt(durasi, 10) || 1;
    while (hasilTanggal.length < targetHari) {
      var day = cur.getUTCDay(); // 0 = Minggu, 6 = Sabtu
      var iso = cur.toISOString().split('T')[0];
      if (day !== 0 && day !== 6 && !mapLibur[iso]) {
        hasilTanggal.push(iso);
      }
      cur.setUTCDate(cur.getUTCDate() + 1);
    }
  } else {
    var pAkhir = String(tglAkhir).split('-');
    var end = new Date(Date.UTC(parseInt(pAkhir[0], 10), parseInt(pAkhir[1], 10) - 1, parseInt(pAkhir[2], 10)));
    while (cur <= end) {
      var d = cur.getUTCDay();
      var isoEnd = cur.toISOString().split('T')[0];
      if (d !== 0 && d !== 6 && !mapLibur[isoEnd]) {
        hasilTanggal.push(isoEnd);
      }
      cur.setUTCDate(cur.getUTCDate() + 1);
    }
  }
  return hasilTanggal;
}

function kirimCutiKeSupabase(nip, nama, sekolah, tglMulai, tglAkhir, durasi, satuan) {
  if (!SUPABASE_KEY || SUPABASE_KEY === 'PASTE_ANON_PUBLIC_KEY_SUPABASE_ANDA_DISINI') {
    Logger.log('SUPABASE_KEY belum diisi.');
    return;
  }

  var nipClean = String(nip).replace(/\D/g, '');
  var daftarTanggal = generateTanggalHariKerjaCuti(tglMulai, tglAkhir, durasi, satuan);
  if (daftarTanggal.length === 0) return;

  var headers = {
    'apikey': SUPABASE_KEY,
    'Authorization': 'Bearer ' + SUPABASE_KEY,
    'Content-Type': 'application/json',
    'Prefer': 'return=minimal'
  };

  // Cek tanggal yang sudah ada di tabel absensi agar tidak duplikat
  var checkUrl = SUPABASE_URL + '/rest/v1/absensi?select=tanggal&nip=eq.' + encodeURIComponent(nipClean) +
                 '&tanggal=in.(' + daftarTanggal.join(',') + ')';
  var existingDates = {};
  try {
    var checkRes = UrlFetchApp.fetch(checkUrl, { method: 'get', headers: headers, muteHttpExceptions: true });
    if (checkRes.getResponseCode() === 200) {
      var rows = JSON.parse(checkRes.getContentText());
      rows.forEach(function(r) { existingDates[r.tanggal] = true; });
    }
  } catch (e) {
    Logger.log('Gagal cek duplikat Supabase: ' + e.message);
  }

  // Siapkan payload per hari kerja sesuai kolom tabel absensi Supabase
  var payload = [];
  for (var i = 0; i < daftarTanggal.length; i++) {
    var tgl = daftarTanggal[i];
    if (!existingDates[tgl]) {
      payload.push({
        nip: nipClean,
        nama: String(nama).trim(),
        sekolah: String(sekolah || '-').trim(),
        tanggal: tgl,
        jam: null,
        jarak_m: null,
        status: 'CUTI',
        foto_bukti: null
      });
    }
  }

  if (payload.length === 0) return;

  var insertRes = UrlFetchApp.fetch(SUPABASE_URL + '/rest/v1/absensi', {
    method: 'post',
    headers: headers,
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  if (insertRes.getResponseCode() >= 300) {
    Logger.log('Error Insert Supabase (' + insertRes.getResponseCode() + '): ' + insertRes.getContentText());
    return { success: false, message: 'HTTP ' + insertRes.getResponseCode() + ': ' + insertRes.getContentText() };
  }

  return { success: true, jumlahHari: payload.length };
}

