function simpanStatusAbsensiSupabase(nip, nama, sekolah, statusAbsensi, tglMulai, tglAkhir) {
  if (!SUPABASE_KEY || SUPABASE_KEY === 'PASTE_ANON_PUBLIC_KEY_SUPABASE_ANDA_DISINI') {
    return { success: false, message: 'Konfigurasi SUPABASE_KEY belum diisi di Code.gs.' };
  }

  var nipClean = String(nip).replace(/\D/g, '');
  var statusClean = String(statusAbsensi || '').trim().toUpperCase();
  if (['DINAS LUAR', 'SAKIT', 'IZIN'].indexOf(statusClean) === -1) {
    return { success: false, message: 'Jenis status tidak valid.' };
  }

  // Pecah rentang tanggal menjadi hari kerja (Senin - Jumat)
  var daftarTanggal = generateTanggalHariKerjaCuti(tglMulai, tglAkhir, 0, 'range');
  if (daftarTanggal.length === 0) {
    return { success: false, message: 'Rentang tanggal yang dipilih hanya berisi hari libur (Sabtu/Minggu).' };
  }

  var headers = {
    'apikey': SUPABASE_KEY,
    'Authorization': 'Bearer ' + SUPABASE_KEY,
    'Content-Type': 'application/json',
    'Prefer': 'return=minimal'
  };

  // Cek tanggal yang sudah ada agar tidak duplikat di Supabase
  var checkUrl = SUPABASE_URL + '/rest/v1/absensi?select=tanggal&nip=eq.' + encodeURIComponent(nipClean) +
                 '&tanggal=in.(' + daftarTanggal.join(',') + ')';
  var existingDates = {};
  try {
    var checkRes = UrlFetchApp.fetch(checkUrl, { method: 'get', headers: headers, muteHttpExceptions: true });
    if (checkRes.getResponseCode() === 200) {
      var rows = JSON.parse(checkRes.getContentText());
      rows.forEach(function(r) { existingDates[r.tanggal] = true; });
    }
  } catch (e) {
    Logger.log('Gagal cek duplikat Supabase: ' + e.message);
  }

  var payload = [];
  for (var i = 0; i < daftarTanggal.length; i++) {
    var tgl = daftarTanggal[i];
    if (!existingDates[tgl]) {
      payload.push({
        nip: nipClean,
        nama: String(nama).trim(),
        sekolah: String(sekolah || '-').trim(),
        tanggal: tgl,
        jam: null,
        jarak_m: null,
        status: statusClean,
        foto_bukti: null
      });
    }
  }

  if (payload.length === 0) {
    return { success: false, message: 'Semua tanggal pada rentang tersebut sudah tercatat di Supabase untuk NIP ini.' };
  }

  var insertRes = UrlFetchApp.fetch(SUPABASE_URL + '/rest/v1/absensi', {
    method: 'post',
    headers: headers,
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  if (insertRes.getResponseCode() >= 300) {
    return { success: false, message: 'Gagal menyimpan ke Supabase (' + insertRes.getResponseCode() + '): ' + insertRes.getContentText() };
  }

  return {
    success: true,
    jumlahHari: payload.length,
    dilewati: daftarTanggal.length - payload.length
  };
}

