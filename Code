const SHEET_ID = '1K4Qa62tNBK7yHU32g43RoeANaV8sqXa_5LcGTBxYQJw';

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('E-TARA CUTI - Cabdin Wil IV')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function initSheet(sheetName, headers) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    sheet.appendRow(headers);
  }
  return sheet;
}

function getDB() {
  initSheet("Akun_Admin", ["NIP", "Nama", "Username", "Password", "Role", "ID"]);
  initSheet("Data_ASN", ["NIP", "Nama", "Status", "Jabatan", "Sekolah", "CutiDiambil"]);
  initSheet("Riwayat_Cuti", ["ID", "NIP", "Nama", "Jenis", "TglMulai", "TglAkhir", "Durasi", "Satuan", "Status", "TglAju", "Alasan"]);

  var ss = SpreadsheetApp.openById(SHEET_ID);
  
  var sAkun = ss.getSheetByName("Akun_Admin").getDataRange().getValues().slice(1);
  var dbUsers = sAkun.map(function(r) { 
    return { nip: r[0], nama: r[1], username: r[2], password: r[3], role: r[4] ? r[4] : 'Admin', id: r[5] ? r[5] : Date.now() + Math.floor(Math.random()*1000) }; 
  }).filter(function(u){ return u.username; });

  var sASN = ss.getSheetByName("Data_ASN").getDataRange().getValues().slice(1);
  var dbASN = sASN.map(function(r) { 
    return { nip: r[0], nama: r[1], status: r[2], jabatan: r[3], sekolah: r[4], cutiDiambil: r[5] ? JSON.parse(r[5]) : {'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0} }; 
  }).filter(function(a){ return a.nip; });

  var sCuti = ss.getSheetByName("Riwayat_Cuti").getDataRange().getValues().slice(1);
  var dbCuti = sCuti.map(function(r) { 
    var tglM = (r[4] instanceof Date) ? r[4].toISOString().split('T')[0] : r[4];
    var tglA = (r[5] instanceof Date) ? r[5].toISOString().split('T')[0] : r[5];
    var tglAju = (r[9] instanceof Date) ? r[9].toISOString().split('T')[0] : r[9];

    return { id: r[0], nip: r[1], nama: r[2], jenis: r[3], tglMulai: tglM, tglAkhir: tglA, durasi: r[6], satuan: r[7], status: r[8], tglAju: tglAju, alasan: r[10] || '-' }; 
  }).filter(function(c){ return c.id; });

  return { dbUsers: dbUsers, dbASN: dbASN, dbCuti: dbCuti };
}

function simpanAkun(id, nip, nama, username, password, role, isEdit) {
  var sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName("Akun_Admin");
  if (isEdit) {
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (data[i][5] == id) {
        sheet.getRange(i + 1, 1, 1, 6).setValues([[nip, nama, username, password, role, id]]);
        return "Edited";
      }
    }
  }
  sheet.appendRow([nip, nama, username, password, role, id]);
  return "Saved";
}

function simpanASN(nip, nama, status, jabatan, sekolah, isEdit) {
  var sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName("Data_ASN");
  var data = sheet.getDataRange().getValues();

  if (isEdit) {
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == nip) {
        sheet.getRange(i + 1, 2, 1, 4).setValues([[nama, status, jabatan, sekolah]]);
        return "Edited";
      }
    }
  } else {
    for (var j = 1; j < data.length; j++) {
      if (data[j][0] == nip) {
        return "Duplicate";
      }
    }
    
    var cutiStr = JSON.stringify({'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0});
    sheet.appendRow([nip, nama, status, jabatan, sekolah, cutiStr]);
    return "Saved";
  }
}

function simpanCuti(id, nip, nama, jenis, tglMulai, tglAkhir, durasi, satuan, status, tglAju, alasan, updatedCutiDiambilStr) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheetCuti = ss.getSheetByName("Riwayat_Cuti");
  sheetCuti.appendRow([id, nip, nama, jenis, tglMulai, tglAkhir, durasi, satuan, status, tglAju, alasan]);
  
  var sheetASN = ss.getSheetByName("Data_ASN");
  var dataASN = sheetASN.getDataRange().getValues();
  for (var i = 1; i < dataASN.length; i++) {
    if (dataASN[i][0] == nip) {
      sheetASN.getRange(i + 1, 6).setValue(updatedCutiDiambilStr);
      break;
    }
  }
  return "Saved";
}

function updateStatusCuti(id, statusTujuan, nip, updatedCutiDiambilStr) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheetCuti = ss.getSheetByName("Riwayat_Cuti");
  var dataCuti = sheetCuti.getDataRange().getValues();
  for (var i = 1; i < dataCuti.length; i++) {
    if (dataCuti[i][0] == id) {
      sheetCuti.getRange(i + 1, 9).setValue(statusTujuan);
      break;
    }
  }
  
  var sheetASN = ss.getSheetByName("Data_ASN");
  var dataASN = sheetASN.getDataRange().getValues();
  for (var j = 1; j < dataASN.length; j++) {
    if (dataASN[j][0] == nip) {
      sheetASN.getRange(j + 1, 6).setValue(updatedCutiDiambilStr);
      break;
    }
  }
  return "Updated";
}

function uploadASNBulk(dataArray) {
  var sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName("Data_ASN");
  var cutiStr = JSON.stringify({'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0});
  for(var i=0; i<dataArray.length; i++){
     var row = dataArray[i];
     var nip = row['NIP'] || row['NIP / NI PPPK'] || row['nip'] || '-';
     var nama = row['Nama'] || row['Nama Lengkap'] || row['nama'] || '-';
     var status = row['Status'] || row['status'] || 'PNS';
     var jabatan = row['Jabatan'] || row['jabatan'] || '-';
     var sekolah = row['Sekolah'] || row['sekolah'] || '-';
     
     sheet.appendRow([nip, nama, status, jabatan, sekolah, cutiStr]);
  }
  return "Bulk Saved";
}

// ---------------------------------------------------------
// FUNGSI EXPORT RIWAYAT CUTI KE EXCEL TERFORMAT
// ---------------------------------------------------------
function exportRiwayatExcel(currentUser) {
  // Buat file spreadsheet sementara di Google Drive
  var ss = SpreadsheetApp.create("Temp_Riwayat_Cuti");
  var sheet = ss.getActiveSheet();
  sheet.setName("Riwayat Cuti");
  
  // Ambil seluruh data riwayat cuti dari database
  var dbCuti = getDB().dbCuti;
  
  // 1. Judul Header Laporan
  sheet.getRange("A1:H1").merge().setValue("REKAPITULASI RIWAYAT CUTI ASN").setFontWeight("bold").setFontSize(14).setHorizontalAlignment("center");
  sheet.getRange("A2:H2").merge().setValue("CABANG DINAS PENDIDIKAN WILAYAH IV").setFontWeight("bold").setFontSize(12).setHorizontalAlignment("center");
  sheet.getRange("A3:H3").merge().setValue("PEMERINTAH PROVINSI SULAWESI SELATAN").setFontSize(10).setHorizontalAlignment("center");
  
  // 2. Header Tabel (Baris ke-5)
  var headers = ["No", "Tgl Pengajuan", "NIP / NI PPPK", "Nama Pegawai", "Jenis Cuti", "Durasi", "Status", "Alasan Cuti"];
  sheet.getRange(5, 1, 1, headers.length)
       .setValues([headers])
       .setFontWeight("bold")
       .setBackground("#1e3a8a")
       .setFontColor("#ffffff")
       .setHorizontalAlignment("center")
       .setVerticalAlignment("middle");
  sheet.setRowHeight(5, 28);
  
  // 3. Mengisi Seluruh Data
  var rows = [];
  for (var i = 0; i < dbCuti.length; i++) {
    var c = dbCuti[i];
    rows.push([
      i + 1,
      c.tglAju,
      "'" + c.nip, // Ditambah petik tunggal agar NIP tidak terpotong
      c.nama,
      c.jenis,
      c.durasi + " " + c.satuan,
      c.status,
      c.alasan || '-'
    ]);
  }
  
  if (rows.length > 0) {
    sheet.getRange(6, 1, rows.length, headers.length).setValues(rows);
    
    // Beri garis/border pada seluruh tabel
    var dataRange = sheet.getRange(5, 1, rows.length + 1, headers.length);
    dataRange.setBorder(true, true, true, true, true, true, "#000000", SpreadsheetApp.BorderStyle.SOLID);
    
    // Peratur rata posisi teks
    sheet.getRange(6, 1, rows.length, 1).setHorizontalAlignment("center"); // No
    sheet.getRange(6, 2, rows.length, 1).setHorizontalAlignment("center"); // Tgl Pengajuan
    sheet.getRange(6, 3, rows.length, 1).setHorizontalAlignment("center"); // NIP
    sheet.getRange(6, 5, rows.length, 1).setHorizontalAlignment("center"); // Jenis Cuti
    sheet.getRange(6, 6, rows.length, 1).setHorizontalAlignment("center"); // Durasi
    sheet.getRange(6, 7, rows.length, 1).setHorizontalAlignment("center"); // Status
    sheet.getRange(6, 8, rows.length, 1).setHorizontalAlignment("left");   // Alasan
  }
  
  // Pengaturan Lebar Kolom
  sheet.setColumnWidth(1, 50);  // No
  sheet.setColumnWidth(2, 130); // Tgl Pengajuan
  sheet.setColumnWidth(3, 190); // NIP
  sheet.setColumnWidth(4, 230); // Nama
  sheet.setColumnWidth(5, 140); // Jenis
  sheet.setColumnWidth(6, 100); // Durasi
  sheet.setColumnWidth(7, 120); // Status
  sheet.setColumnWidth(8, 280); // Alasan
  
  // 4. Format Tanggal & Blok Tanda Tangan
  var lastRow = 5 + (rows.length > 0 ? rows.length : 1);
  var sigStartRow = lastRow + 3;
  
  var bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
  var today = new Date();
  var tglStr = "Wajo, " + today.getDate() + " " + bulanIndo[today.getMonth()] + " " + today.getFullYear();
  
  // Baris Tanggal (Sebelah Kanan)
  sheet.getRange(sigStartRow, 6, 1, 3).merge().setValue(tglStr).setHorizontalAlignment("center");
  
  // Jabatan Penandatangan
  sheet.getRange(sigStartRow + 1, 1, 1, 4).merge().setValue("Mengetahui,\nKepala Cabang Dinas Pendidikan Wil IV").setHorizontalAlignment("center");
  sheet.getRange(sigStartRow + 1, 6, 1, 3).merge().setValue("Pengelola Cuti,").setHorizontalAlignment("center");
  
  var nameRow = sigStartRow + 6;
  
  // Tanda Tangan Kiri (Kepala Cabang Dinas)
  sheet.getRange(nameRow, 1, 1, 4).merge().setValue("Dr. SETTARAMING, S.Pd., M.Si").setFontWeight("bold").setFontLine("underline").setHorizontalAlignment("center");
  sheet.getRange(nameRow + 1, 1, 1, 4).merge().setValue("NIP. 197204031998011001").setHorizontalAlignment("center");
  
  // Tanda Tangan Kanan (Admin / Superadmin Aktif)
  var adminNama = currentUser ? currentUser.nama : "Admin Sistem";
  var adminNip = (currentUser && currentUser.nip && currentUser.nip !== '-') ? "NIP. " + currentUser.nip : "NIP. -";
  
  sheet.getRange(nameRow, 6, 1, 3).merge().setValue(adminNama).setFontWeight("bold").setFontLine("underline").setHorizontalAlignment("center");
  sheet.getRange(nameRow + 1, 6, 1, 3).merge().setValue(adminNip).setHorizontalAlignment("center");
  
  SpreadsheetApp.flush();
  
  // 5. Unduh sebagai file Excel (.xlsx) melalui endpoint resmi Google
  var id = ss.getId();
  var url = "https://docs.google.com/spreadsheets/d/" + id + "/export?format=xlsx";
  var params = {
    method: "get",
    headers: { "Authorization": "Bearer " + ScriptApp.getOAuthToken() },
    muteHttpExceptions: true
  };
  
  var response = UrlFetchApp.fetch(url, params);
  var blob = response.getBlob();
  var base64 = Utilities.base64Encode(blob.getBytes());
  
  // Hapus file temporary di Drive
  DriveApp.getFileById(id).setTrashed(true);
  
  return {
    filename: "Riwayat_Cuti_Cabdin_Wil_IV_" + today.getFullYear() + "_" + (today.getMonth() + 1) + "_" + today.getDate() + ".xlsx",
    base64: base64
  };
}
