function initSheet(sheetName, headers) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    sheet.appendRow(headers);
  }
  return sheet;
}

// Fungsi untuk mengecek pergantian tahun dan menggeser data Rekapan
function cekDanGeserTahunRekapan(ss) {
  var prop = PropertiesService.getScriptProperties();
  var tahunSekarang = new Date().getFullYear().toString();
  var tahunTerakhirUpdate = prop.getProperty("TAHUN_UPDATE_REKAPAN") || "";
  var isUpdatedNow = false;

  if (tahunTerakhirUpdate !== tahunSekarang) {
    var sheetRekapan = ss.getSheetByName("Rekapan");
    if (sheetRekapan) {
      var dataRekapan = sheetRekapan.getDataRange().getValues();
      
      for (var i = 1; i < dataRekapan.length; i++) {
        var nip = dataRekapan[i][0];
        if (nip) {
          var tahun1 = dataRekapan[i][2]; // Kolom C (Tahun 1)
          var tahunSekarangValue = dataRekapan[i][4]; // Kolom E (Tahun Sekarang)
          
          // Pergeseran: Tahun 1 -> Tahun 2, Tahun Sekarang -> Tahun 1, Kosongkan Tahun Sekarang
          sheetRekapan.getRange(i + 1, 4).setValue(tahun1); // Set Tahun 2
          sheetRekapan.getRange(i + 1, 3).setValue(tahunSekarangValue); // Set Tahun 1
          sheetRekapan.getRange(i + 1, 5).setValue(""); // Kosongkan Tahun Sekarang
        }
      }
      prop.setProperty("TAHUN_UPDATE_REKAPAN", tahunSekarang);
      isUpdatedNow = true;
    }
  }
  return isUpdatedNow;
}

function getDB() {
  initSheet("Akun_Admin", ["NIP", "Nama", "Username", "Password", "Role", "ID"]);
  initSheet("Data_ASN", ["NIP", "Nama", "Status", "Jabatan", "Sekolah", "CutiDiambil"]);
  initSheet("Riwayat_Cuti", ["ID", "NIP", "Nama", "Jenis", "TglMulai", "TglAkhir", "Durasi", "Satuan", "Status", "TglAju", "Alasan"]);
  initSheet("Rekapan", ["NIP", "Nama", "Tahun 1", "Tahun 2", "Tahun Sekarang"]);

  var ss = SpreadsheetApp.openById(SHEET_ID);
  var showGhazaliPopup = cekDanGeserTahunRekapan(ss);
  
  var sAkun = ss.getSheetByName("Akun_Admin").getDataRange().getValues().slice(1);
  var dbUsers = sAkun.map(function(r) { 
    return { nip: r[0], nama: r[1], username: r[2], password: r[3], role: r[4] ? r[4] : 'Admin', id: r[5] ? r[5] : Date.now() + Math.floor(Math.random()*1000) }; 
  }).filter(function(u){ return u.username; });

  var sASN = ss.getSheetByName("Data_ASN").getDataRange().getValues().slice(1);
  var dbASN = sASN.map(function(r) { 
    return { nip: r[0], nama: r[1], status: r[2], jabatan: r[3], sekolah: r[4], cutiDiambil: r[5] ? JSON.parse(r[5]) : {'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0} }; 
  }).filter(function(a){ return a.nip; });

  var sCuti = ss.getSheetByName("Riwayat_Cuti").getDataRange().getValues().slice(1);
  var dbCuti = sCuti.map(function(r) { 
    var tglM = (r[4] instanceof Date) ? r[4].toISOString().split('T')[0] : r[4];
    var tglA = (r[5] instanceof Date) ? r[5].toISOString().split('T')[0] : r[5];
    var tglAju = (r[9] instanceof Date) ? r[9].toISOString().split('T')[0] : r[9];

    return { id: r[0], nip: r[1], nama: r[2], jenis: r[3], tglMulai: tglM, tglAkhir: tglA, durasi: r[6], satuan: r[7], status: r[8], tglAju: tglAju, alasan: r[10] || '-' }; 
  }).filter(function(c){ return c.id; });

  var sRekapan = ss.getSheetByName("Rekapan").getDataRange().getValues().slice(1);
  var dbRekapan = sRekapan.map(function(r) {
    return { nip: r[0], nama: r[1], tahun1: r[2] || '', tahun2: r[3] || '', tahunSekarang: r[4] || '' };
  }).filter(function(rk){ return rk.nip; });

  return { dbUsers: dbUsers, dbASN: dbASN, dbCuti: dbCuti, dbRekapan: dbRekapan, showPopupAwalTahun: showGhazaliPopup };
}

function simpanCuti(id, nip, nama, jenis, tglMulai, tglAkhir, durasi, satuan, status, tglAju, alasan, updatedCutiDiambilStr) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheetCuti = ss.getSheetByName("Riwayat_Cuti");
  sheetCuti.appendRow([id, nip, nama, jenis, tglMulai, tglAkhir, durasi, satuan, status, tglAju, alasan]);
  
  var sheetASN = ss.getSheetByName("Data_ASN");
  var dataASN = sheetASN.getDataRange().getValues();
  for (var i = 1; i < dataASN.length; i++) {
    if (dataASN[i][0] == nip) {
      sheetASN.getRange(i + 1, 6).setValue(updatedCutiDiambilStr);
      break;
    }
  }

  // Update sheet Rekapan (Khusus Cuti Tahunan dikelompokkan pada kolom Tahun Sekarang / Kolom 5)
  if (jenis.toLowerCase() === 'tahunan') {
    var sheetRekapan = ss.getSheetByName("Rekapan");
    var dataRekapan = sheetRekapan.getDataRange().getValues();
    var found = false;
    for (var k = 1; k < dataRekapan.length; k++) {
      if (dataRekapan[k][0] == nip) {
        var currentTahunSekarang = sheetRekapan.getRange(k + 1, 5).getValue();
        var newTglVal = currentTahunSekarang ? currentTahunSekarang + ", " + tglAju : tglAju;
        sheetRekapan.getRange(k + 1, 5).setValue(newTglVal);
        found = true;
        break;
      }
    }
    if (!found) {
      sheetRekapan.appendRow([nip, nama, "", "", tglAju]);
    }
  }

  return "Saved";
}

function simpanAkun(id, nip, nama, user, pass, role, isEdit) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheet = ss.getSheetByName("Akun_Admin");
  var data = sheet.getDataRange().getValues();

  if (isEdit) {
    for (var i = 1; i < data.length; i++) {
      if (data[i][5] == id) { // Index 5 adalah kolom ID
        sheet.getRange(i + 1, 1, 1, 5).setValues([[nip, nama, user, pass, role]]);
        return "Edited";
      }
    }
  } else {
    // Validasi agar username tidak ganda (opsional)
    for (var j = 1; j < data.length; j++) {
      if (data[j][2] == user) {
        return "Duplicate";
      }
    }
    sheet.appendRow([nip, nama, user, pass, role, id]);
    return "Saved";
  }
}

function simpanASN(nip, nama, status, jabatan, sekolah, isEdit) {
  var sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName("Data_ASN");
  var data = sheet.getDataRange().getValues();

  if (isEdit) {
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] == nip) {
        sheet.getRange(i + 1, 2, 1, 4).setValues([[nama, status, jabatan, sekolah]]);
        return "Edited";
      }
    }
  } else {
    for (var j = 1; j < data.length; j++) {
      if (data[j][0] == nip) {
        return "Duplicate";
      }
    }
    
    var cutiStr = JSON.stringify({'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0});
    sheet.appendRow([nip, nama, status, jabatan, sekolah, cutiStr]);
    return "Saved";
  }
}

function updateStatusCuti(id, statusTujuan, nip, updatedCutiDiambilStr) {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheetCuti = ss.getSheetByName("Riwayat_Cuti");
  var dataCuti = sheetCuti.getDataRange().getValues();
  for (var i = 1; i < dataCuti.length; i++) {
    if (dataCuti[i][0] == id) {
      sheetCuti.getRange(i + 1, 9).setValue(statusTujuan);
      break;
    }
  }
  
  var sheetASN = ss.getSheetByName("Data_ASN");
  var dataASN = sheetASN.getDataRange().getValues();
  for (var j = 1; j < dataASN.length; j++) {
    if (dataASN[j][0] == nip) {
      sheetASN.getRange(j + 1, 6).setValue(updatedCutiDiambilStr);
      break;
    }
  }
  return "Updated";
}

function uploadASNBulk(dataArray) {
  var sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName("Data_ASN");
  var cutiStr = JSON.stringify({'Tahunan':0,'Besar':0,'Sakit':0,'Melahirkan':0,'Alasan Penting':0,'CLTN':0});
  for(var i=0; i<dataArray.length; i++){
     var row = dataArray[i];
     var nip = row['NIP'] || row['NIP / NI PPPK'] || row['nip'] || '-';
     var nama = row['Nama'] || row['Nama Lengkap'] || row['nama'] || '-';
     var status = row['Status'] || row['status'] || 'PNS';
     var jabatan = row['Jabatan'] || row['jabatan'] || '-';
     var sekolah = row['Sekolah'] || row['sekolah'] || '-';
     
     sheet.appendRow([nip, nama, status, jabatan, sekolah, cutiStr]);
  }
  return "Bulk Saved";
}

